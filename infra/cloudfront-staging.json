{
  "CallerReference": "taskflow-staging-001",
  "Comment": "TaskFlow STAGING distribution",
  "Enabled": true,
  "DefaultRootObject": "index.html",
  "Origins": {
    "Quantity": 1,
    "Items": [
      {
        "Id": "taskflow-staging-origin",
        "DomainName": "<STAGING_BUCKET>.s3.<AWS_REGION>.amazonaws.com",
        "OriginAccessControlId": "<OAC_ID>",
        "S3OriginConfig": {
          "OriginAccessIdentity": ""
        }
      }
    ]
  },
  "DefaultCacheBehavior": {
    "TargetOriginId": "taskflow-staging-origin",
    "ViewerProtocolPolicy": "redirect-to-https",
    "AllowedMethods": {
      "Quantity": 2,
      "Items": ["GET", "HEAD"]
    },
    "CachedMethods": {
      "Quantity": 2,
      "Items": ["GET", "HEAD"]
    },
    "Compress": true,
    "ForwardHeaders": {
      "Quantity": 0
    },
    "CookiesForward": "none",
    "QueryString": false,
    "TrustedSigners": {
      "Enabled": false,
      "Quantity": 0
    }
  }
}
