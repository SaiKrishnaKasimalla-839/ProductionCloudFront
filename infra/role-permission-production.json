{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProductionBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<PRODUCTION_BUCKET>"
    },
    {
      "Sid": "ReadWriteProductionObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::<PRODUCTION_BUCKET>/*"
    },
    {
      "Sid": "InvalidateProductionCache",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::<ACCOUNT_ID>:distribution/<PRODUCTION_DISTRIBUTION_ID>"
    }
  ]
}
